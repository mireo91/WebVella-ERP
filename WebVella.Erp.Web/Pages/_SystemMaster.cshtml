@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Radzen.Blazor
@using WebVella.Erp
@using WebVella.TagHelpers.TagHelpers
<!DOCTYPE html>
<html lang="@ErpSettings.Lang">
<head>
	<base href="~/" />
	<vc:render-hook placeholder="head-top" page-model="@Model"  model="null"></vc:render-hook>
	<wv-includes></wv-includes>
	<vc:render-hook placeholder="head-bottom" page-model="@Model"  model="null"></vc:render-hook>
	<component type="typeof(RadzenTheme)" render-mode="ServerPrerendered" param-Theme="@("material")" />
</head>
<body class="@ViewData["BodyClass"] system" style="@ViewData["SystemMasterBodyStyle"]">
    @RenderBody()
	<vc:render-hook placeholder="body-top" page-model="@Model"  model="null"></vc:render-hook>
	<vc:render-hook placeholder="body-bottom" page-model="@Model"  model="null"></vc:render-hook>
    <vc:screen-message></vc:screen-message>
    <script src="_framework/blazor.server.js" autostart="false"></script>
    <script>
	    (function start() {
		    Blazor.start({
			    logLevel: 1, // LogLevel.Debug
			    configureSignalR: builder => builder.configureLogging("debug"), // LogLevel.Debug
			    reconnectionOptions: {
				    maxRetries: 99999999,
				    retryIntervalMilliseconds: 1000,
			    }
		    });

	    })()
    </script>
    <script>
	    function customDisplay() {
		    return {
			    show: () => { console.log('blazor show'); },
			    hide: () => { console.log('blazor hide'); },
			    failed: () => { console.log('blazor failed'); },
			    rejected: () => { console.log('blazor rejected'); window.location.reload();}
		    };
	    }

	    Blazor.defaultReconnectionHandler._reconnectionDisplay = customDisplay();

    </script>
    
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js?v=@(typeof(Radzen.Colors).Assembly.GetName().Version)"></script>
</body>
</html>
