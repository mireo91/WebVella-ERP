@addTagHelper *, WebVella.Erp.Plugins.Core
@addTagHelper *, WebVella.Erp.Web
@addTagHelper *, WebVella.TagHelpers
@using WebVella.Erp.Web.Utils;
@using WebVella.Erp.Web.Components;
@using WebVella.Erp.Web.Models;
@using WebVella.TagHelpers.Models;
@{
	var node = (PageBodyNode)ViewBag.Node;
}

@await Html.PartialAsync("~/Components/PcFieldText/Design.cshtml")
<wv-section id="wv-@(node.Id)" body-class="" class="" field-mode="@WvFieldRenderMode.Undefined"
            label-mode="@WvLabelRenderMode.Undefined" is-card="false" is-collapsable="true" is-collapsed="true"
            title="Validators" title-tag="h3">
<wv-pb-node-container parent-node-id="@node.Id" container-id="validators"></wv-pb-node-container>
</wv-section>