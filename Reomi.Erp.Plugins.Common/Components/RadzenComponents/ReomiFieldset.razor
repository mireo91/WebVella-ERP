@using System.Text.Json
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime;
@using Radzen
@using Radzen.Blazor

@inject NotificationService NotificationService
@inherits ReomiCollectionComponentBase<WebVella.Erp.Web.Components.PcSection.PcSectionOptions>
@inject HttpClient Client

@if (IsVisible)
{
        <RadzenFieldset AllowCollapse="@FieldOptions.IsCollapsable" Collapsed="@FieldOptions.IsCollapsed" ExpandTitle="Expand fieldset." CollapseTitle="Collapse fieldset."
                        ExpandAriaLabel="Expand fieldset." CollapseAriaLabel="Collapse fieldset."
                        Expand=@(() => Change("Fieldset expanded")) Collapse=@(() => Change("Fieldset collapsed"))>
            <HeaderTemplate>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                    @* <RadzenIcon Icon="account_box"/> *@
                    <b>@FieldOptions.Title</b>
                </RadzenStack>
            </HeaderTemplate>
            <ChildContent>
                @RenderNodes(Context.Node.Nodes.FindAll(n => n.ContainerId == "body"))
            </ChildContent>
            <SummaryTemplate>
                @RenderNodes(Context.Node.Nodes.FindAll(n => n.ContainerId == "summary"))
            </SummaryTemplate>
        </RadzenFieldset>

}