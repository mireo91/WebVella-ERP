<RadzenDataGrid @ref="grid" AllowFiltering="true" AllowSorting="true" AllowColumnResize="true"
                RowRender="@RowRender" LoadChildData="@LoadChildData" Data="@gridEntities" TItem="IDictionary<string, object>"
                RowCollapse="@(args => grid.ColumnsCollection.ToList().ForEach(c => c.ClearFilters()))">
	<HeaderTemplate>
		<RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add_circle" Text="Add New Order" Click="@InsertRow" />
	</HeaderTemplate>
	<Columns>
		<RadzenDataGridColumn Title="Title" Frozen="true" Sortable="false" Filterable="false" Width="300px">
			<Template Context="data">
				<strong>@data["title"]</strong>
			</Template>
			<EditTemplate Context="data">
				<RadzenTextBox Value="@((string)data["title"])" Style="width:200px; display: block" Name="title" aria-label="Enter title"/>
				<RadzenRequiredValidator Text="Title is required" Component="title" Popup="true"/>
			</EditTemplate>
		</RadzenDataGridColumn>
		<RadzenDataGridColumn Title="Description">
			<Template Context="data">
				<strong>@data["description"]</strong>
			</Template>
			<EditTemplate Context="data">
				<RadzenTextBox Value="@((string)data["description"])" Style="width:200px; display: block" Name="description" aria-label="Enter description" />
			</EditTemplate>
		</RadzenDataGridColumn>
		@* @foreach (var column in columns) *@
		@* { *@
		@* 	<RadzenDataGridColumn @key=@column.Key Title="@column.Key" Type="column.Value" *@
		@* 	                      Property="@PropertyAccess.GetDynamicPropertyExpression(column.Key, column.Value)"> *@
		@* 		<Template> *@
		@* 			@context[@column.Key] *@
		@* 		</Template> *@
		@* 	</RadzenDataGridColumn> *@
		@* } *@
		<RadzenDataGridColumn Context="data" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
			<Template Context="data">
				<RadzenSplitButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" Click=@(args => OnClick(args, data)) AlwaysOpenPopup=true title="Add new row after this row" Disabled="@(editMode == DataGridEditMode.Single && entitiesToInsert.Count() > 0)">
					<ChildContent>
						<RadzenSplitButtonItem Text="Insert After" Value="after" />
						<RadzenSplitButtonItem Text="Insert Inside" Value="inside" />
					</ChildContent>
				</RadzenSplitButton>
				@* <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" Click="@(() => InsertAfterRow(order))" title="Add new row after this row" Disabled="@(editMode == DataGridEditMode.Single && entitiesToInsert.Count() > 0)"/> *@
				<RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => EditRow(data))" @onclick:stopPropagation="true"/>
				<RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => DeleteRow(data))" @onclick:stopPropagation="true"/>
			</Template>
			<EditTemplate Context="data">
				<RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow(data))" aria-label="Save"/>
				<RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => CancelEdit(data))" aria-label="Cancel"/>
				<RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => DeleteRow(data))" aria-label="Delete" />
			</EditTemplate>
		</RadzenDataGridColumn>
	</Columns>
</RadzenDataGrid>

@code {
	
    IEnumerable<IDictionary<string, object>> gridEntities;
    RadzenDataGrid<IDictionary<string, object>> grid;
    DataGridEditMode editMode = DataGridEditMode.Single;

    IDictionary<string, object> defaultObject = new Dictionary<string, object>();
    // protected override async Task OnInitializedAsync()
    // {
    //     await base.OnInitializedAsync();
    //
    //     // employees = dbContext.Employees.Where(e => e.ReportsTo == null);
    // }

    void RowRender(RowRenderEventArgs<IDictionary<string, object>> args)
    {
        args.Expandable = data.Any(e => (Guid?)e["parentcategoryid"] == (Guid)args.Data["id"]);
    }

    void LoadChildData(DataGridLoadChildDataEventArgs<IDictionary<string, object>> args)
    {
        args.Data = data.Where(e => (Guid?)e["parentcategoryid"] == (Guid)args.Item["id"]);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (firstRender)
        {
            await grid.ExpandRow(data.FirstOrDefault());
        }
    }

    List<IDictionary<string,object>> entitiesToInsert = new List<IDictionary<string,object>>();
    List<IDictionary<string,object>> entitiesToUpdate = new List<IDictionary<string,object>>();

    void Reset()
    {
	    entitiesToInsert.Clear();
	    entitiesToUpdate.Clear();
    }

    void Reset(IDictionary<string,object> entity)
    {
	    entitiesToInsert.Remove(entity);
	    entitiesToUpdate.Remove(entity);
    }

    async Task EditRow(IDictionary<string,object> entity)
    {
        if (!grid.IsValid) return;

        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }

        entitiesToUpdate.Add(entity);
        await grid.EditRow(entity);
    }

    void OnUpdateRow(IDictionary<string,object> entity)
    {
        Reset(entity);

        // dbContext.Update(order);

        // dbContext.SaveChanges();
    }

    async Task SaveRow(IDictionary<string,object> entity)
    {
        await grid.UpdateRow(entity);
    }

    void CancelEdit(IDictionary<string,object> entity)
    {
        Reset(entity);

        grid.CancelEditRow(entity);

        // var orderEntry = dbContext.Entry(entity);
        // if (orderEntry.State == EntityState.Modified)
        // {
        //     orderEntry.CurrentValues.SetValues(orderEntry.OriginalValues);
        //     orderEntry.State = EntityState.Unchanged;
        // }
    }

    async Task DeleteRow(IDictionary<string,object> entity)
    {
        Reset(entity);

        if (gridEntities.Contains(entity))
        {
            // dbContext.Remove<Order>(order);
            //
            // dbContext.SaveChanges();

            await grid.Reload();
        }
        else
        {
            grid.CancelEditRow(entity);
            await grid.Reload();
        }
    }

    async Task InsertRow()
    {
        if (!grid.IsValid) return;

        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }

        var order = new Dictionary<string, object>(defaultObject);
        entitiesToInsert.Add(order);
        await grid.InsertRow(order);
    }

    async Task InsertAfterRow(IDictionary<string,object> row)
    {
        if (!grid.IsValid) return;

        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }

        var entity = new Dictionary<string,object>(row);
        entitiesToInsert.Add(entity);
        await grid.InsertAfterRow(entity, row);
    }
	
    async Task InsertInsideRow(IDictionary<string,object> row)
    {
	    if (!grid.IsValid) return;

	    if (editMode == DataGridEditMode.Single)
	    {
		    Reset();
	    }

	    var entity = new Dictionary<string,object>(row);
	    entity["parentcategoryid"] = row["id"];
	    entitiesToInsert.Add(entity);
	    await grid.InsertAfterRow(entity, row);
    }

    void OnCreateRow(IDictionary<string,object> entity)
    {
        // dbContext.Add(order);
        //
        // dbContext.SaveChanges();

        entitiesToInsert.Remove(entity);
    }
    
    void OnClick(RadzenSplitButtonItem item, IDictionary<string,object> entity)
    {
	    if (item != null)
	    {
		    switch (item.Value)
		    {
			    case "inside":
				    InsertInsideRow(entity);
				    break;
				case "after":
				    InsertAfterRow(entity);
				    break;
		    }
		    Console.WriteLine($"item with value {item.Value} clicked");
		    // NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "SplitButton Item Clicked", Detail = $"{buttonName}, item with value {item.Value} clicked" });
	    }
	    else
	    {
		    // Console.WriteLine($"clicked");
		    // NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "SplitButton Clicked", Detail = $"{buttonName} clicked" });
	    }
    }
}

