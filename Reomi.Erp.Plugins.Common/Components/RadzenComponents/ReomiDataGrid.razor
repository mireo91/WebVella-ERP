@* @inherits ReomiDataGridBase *@
@inject DialogService DialogService
@inject NotificationService NotificationService


<RadzenDataGrid @ref="grid" allowAlternatingRows="false" AllowFiltering="true" AllowPaging="false" PageSize="1000" AllowSorting="true" 
                RowRender="@RowRender" LoadChildData="@LoadChildData" Data="@gridEntities" TItem="IDictionary<string,object>"  Density="@Density.Compact"
                RowCollapse="@(args => grid.ColumnsCollection.ToList().ForEach(c => c.ClearFilters()))"
                RowUpdate="@OnUpdateRow" RowCreate="@OnCreateRow" Sort="@Reset" Page="@Reset" Filter="@Reset">
	<HeaderTemplate>
		<RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add_circle" Text="Add New Order" Click="@InsertRow" />
	</HeaderTemplate>
	<Columns>
		<RadzenDataGridColumn Title="Title" Frozen="true" Sortable="false" Filterable="true" Width="300px" Type=@(Columns["title"]) @key=@("title") Property="@PropertyAccess.GetDynamicPropertyExpression("title", Columns["title"])">
			<Template Context="data">
				<strong>@data["title"]</strong>
			</Template>
			<EditTemplate Context="data">
				<RadzenTextBox Value="@((string)data["title"])" ValueChanged="@(s => OnChangeProperty(data, "title", s))" Style="width:200px; display: block" Name="title" aria-label="Enter title"/>
				<RadzenRequiredValidator Text="Title is required" Component="title" Popup="true"/>
			</EditTemplate>
		</RadzenDataGridColumn>
		<RadzenDataGridColumn Title="Description" Type=@(Columns["description"]) @key=@("description") Property="@PropertyAccess.GetDynamicPropertyExpression("description", Columns["description"])">
			<Template>
				@context["description"]
			</Template>
			<EditTemplate Context="data">
				<RadzenTextBox Value="@((string)data["description"])" ValueChanged="@(s => OnChangeProperty(data, "description", s))" Style="width:100%; display: block" Name="description" aria-label="Enter description" />
			</EditTemplate>
		</RadzenDataGridColumn>
		@* @foreach (var column in columns) *@
		@* { *@
		@* 	<RadzenDataGridColumn @key=@column.Key Title="@column.Key" Type="column.Value" *@
		@* 	                      Property="@PropertyAccess.GetDynamicPropertyExpression(column.Key, column.Value)"> *@
		@* 		<Template> *@
		@* 			@context[@column.Key] *@
		@* 		</Template> *@
		@* 	</RadzenDataGridColumn> *@
		@* } *@
		@if (IsEditable)
		{
			<RadzenDataGridColumn Context="data" Filterable="false" Sortable="false" TextAlign="TextAlign.Right" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
				<Template Context="data">
					<RadzenSplitButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" Click=@(args => OnClick(args, data)) AlwaysOpenPopup=true title="Add new row after this row" Disabled="@(editMode == DataGridEditMode.Single && entitiesToInsert.Count() > 0)">
						<ChildContent>
							<RadzenSplitButtonItem Text="Insert After" Value="after"/>
							<RadzenSplitButtonItem Text="Insert Inside" Value="inside"/>
						</ChildContent>
					</RadzenSplitButton>
					@* <RadzenButton Icon="add_circle" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" Click="@(() => InsertAfterRow(order))" title="Add new row after this row" Disabled="@(editMode == DataGridEditMode.Single && entitiesToInsert.Count() > 0)"/> *@
					<RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(args => EditRow(data))" @onclick:stopPropagation="true"/>
					<RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => DeleteRow(data))" @onclick:stopPropagation="true"/>
				</Template>
				<EditTemplate Context="data">
					<RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" Click="@((args) => SaveRow(data))" aria-label="Save"/>
					<RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@((args) => CancelEdit(data))" aria-label="Cancel"/>
					<RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Size="ButtonSize.Medium" Shade="Shade.Lighter" class="rz-my-1 rz-ms-1" Click="@(args => DeleteRow(data))" aria-label="Delete"/>
				</EditTemplate>
			</RadzenDataGridColumn>
		}
	</Columns>
</RadzenDataGrid>

@code {
	
    IEnumerable<IDictionary<string, object>> gridEntities;
    RadzenDataGrid<IDictionary<string, object>> grid;
    DataGridEditMode editMode = DataGridEditMode.Single;
    // protected override async Task OnInitializedAsync()
    // {
    //     await base.OnInitializedAsync();
    //
    //     // employees = dbContext.Employees.Where(e => e.ReportsTo == null);
    // }
    IDictionary<string, object> draggedItem;

    void RowRender(RowRenderEventArgs<IDictionary<string, object>> args)
    {
        args.Expandable = Data.Any(e => (Guid?)e[HierarchicalPropertyKey] == (Guid)args.Data["id"]);
        if (false)
        {
	        args.Attributes.Add("title", "Drag row to reorder");
	        args.Attributes.Add("style", "cursor:grab");
	        args.Attributes.Add("draggable", "true");
	        args.Attributes.Add("ondragover", "event.preventDefault();event.target.closest('.rz-data-row').classList.add('my-class')");
	        args.Attributes.Add("ondragleave", "event.target.closest('.rz-data-row').classList.remove('my-class')");
	        args.Attributes.Add("ondragstart", EventCallback.Factory.Create<DragEventArgs>(this, () => draggedItem = args.Data));
	        args.Attributes.Add("ondrop", EventCallback.Factory.Create<DragEventArgs>(this, () =>
	        {
		        var draggedIndex = Data.IndexOf(draggedItem);
		        var droppedIndex = Data.IndexOf(args.Data);
		        Data.Remove(draggedItem);
		        Data.Insert(draggedIndex <= droppedIndex ? droppedIndex++ : droppedIndex, draggedItem);

		        for (int i = 0; i < Data.Count; i++)
		        {
			        Data[i]["sequencenumber"] = i;
			        (new RecordManager()).UpdateRecord(EntityRecordName, Data[i].ToEntityObject());
		        }

		        grid.Reload();
		        if (HierarchicalPropertyKey != null && draggedItem[HierarchicalPropertyKey] != null)
		        {
			        grid.CollapseAll();
			        grid.ExpandRows(Data);
		        }

		        JSRuntime.InvokeVoidAsync("eval", $"document.querySelector('.my-class').classList.remove('my-class')");
	        }));
        }
    }

    void LoadChildData(DataGridLoadChildDataEventArgs<IDictionary<string, object>> args)
    {
	    // Console.WriteLine("LoadChildData");
        args.Data = Data.Where(e => (Guid?)e[HierarchicalPropertyKey] == (Guid)args.Item["id"]);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (firstRender)
        {
	        if(IsExpanded)
				await grid.ExpandRows(Data);
        }
    }

    List<EntityRecord> entitiesToInsert = new List<EntityRecord>();
    List<EntityRecord> entitiesToUpdate = new List<EntityRecord>();

    void Reset()
    {
	    // propertiesToRevert.Clear();
	    entitiesToInsert.Clear();
	    entitiesToUpdate.Clear();
    }

    void Reset(EntityRecord entity)
    {
	    // propertiesToRevert.Clear();
	    entitiesToInsert.Remove(entity);
	    entitiesToUpdate.Remove(entity);
    }

    async Task EditRow(IDictionary<string, object> entityProperties)
    {
        if (!grid.IsValid) return;

        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }
        // Console.WriteLine("EditRow");
        entitiesToUpdate.Add(entityProperties.ToEntityObject());
        await grid.EditRow(entityProperties);
    }

    void OnUpdateRow(IDictionary<string, object> entityProperties)
    {
	    
		var queryResponse = (new RecordManager()).UpdateRecord(EntityRecordName, entityProperties.ToEntityObject());
		if (queryResponse.Success)
		{
			Reset(queryResponse.Object.Data.First());
		}
		// dbContext.Update(order);

		// dbContext.SaveChanges();
    }

    async Task SaveRow(IDictionary<string, object> entityProperties)
    {
        await grid.UpdateRow(entityProperties);
    }

    void CancelEdit(IDictionary<string, object> entityProperties)
    {
	    var entityToCancel = entitiesToUpdate.First(e => (Guid)e["id"] == (Guid)entityProperties["id"]);
	    Reset(entityToCancel);

	    foreach (var prop in entityToCancel.Properties.Where(p => p.Key != "id"))
	    {
		    entityProperties[prop.Key] = prop.Value;
	    }
	    grid.CancelEditRow(entityProperties);

	    // var orderEntry = dbContext.Entry(entity);
        // if (orderEntry.State == EntityState.Modified)
        // {
        //     orderEntry.CurrentValues.SetValues(orderEntry.OriginalValues);
        //     orderEntry.State = EntityState.Unchanged;
        // }
    }

    async Task DeleteRow(IDictionary<string,object> entityProperties)
    {
	    var dialog = await DialogService.Confirm("Are you sure?", "Delete row", new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });
	    if (dialog != true) return;
        Reset(entityProperties.ToEntityObject());
        foreach (var e in Data.Where(d => d[HierarchicalPropertyKey] == entityProperties["id"]).ToList())
        {
	        await DeleteRow(e);
        }
        if (Data.Contains(entityProperties))
        {
	        var queryResponse = (new RecordManager()).DeleteRecord(EntityRecordName, (Guid)entityProperties["id"]);
	        if (queryResponse.Success)
	        {
		        Data.Remove(Data.First(e => (Guid)e["id"] == (Guid)entityProperties["id"]));
		        gridEntities = Data.Where(e => e[HierarchicalPropertyKey] == null);
	        }
            // dbContext.Remove<Order>(order);
            //
            // dbContext.SaveChanges();
			// Console.WriteLine("Delete row");
			await grid.Reload();
			await grid.CollapseAll();
			await grid.ExpandRows(Data);
        }
        else
        {
            grid.CancelEditRow(entityProperties);
            await grid.Reload();
        }
    }

    async Task InsertRow()
    {
        if (!grid.IsValid) return;

        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }

        var entity = new EntityRecord();
        entitiesToInsert.Add(entity);
        await grid.InsertRow(entity.Properties.ToDictionary());
    }

    async Task InsertAfterRow(IDictionary<string,object> entityProperties)
    {
        if (!grid.IsValid) return;

        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }

        var entity = new EntityRecord();
        foreach (var param in entityProperties)
        {
	        entity[param.Key] = param.Value;
        }
        entity["id"] = Guid.NewGuid();
        entitiesToInsert.Add(entity);
        await grid.InsertAfterRow(entity.Properties, entityProperties);
    }
	
    async Task InsertInsideRow(IDictionary<string,object> entityProperties)
    {
	    if (!grid.IsValid) return;

	    if (editMode == DataGridEditMode.Single)
	    {
		    Reset();
	    }

	    var entity = new EntityRecord();
	    foreach (var param in entityProperties)
	    {
		    entity[param.Key] = param.Value;
	    }
	    entity[HierarchicalPropertyKey] = entityProperties["id"];
	    entity["id"] = Guid.NewGuid();
	    entitiesToInsert.Add(entity);
	    await grid.InsertAfterRow(entity.Properties, entityProperties);
    }

    void OnCreateRow(IDictionary<string,object> entityProperties)
    {
	    var record = new EntityRecord();
	    foreach (var param in entityProperties)
	    {
			record[param.Key] = param.Value;
	    }
	    var queryResponse = (new RecordManager()).CreateRecord(EntityRecordName, record);
        if (queryResponse.Success)
        {
	        entitiesToInsert.Remove( entitiesToInsert.First(e => (Guid)e["id"] == (Guid)entityProperties["id"]) );
	        Data.Add(entityProperties);
	        gridEntities = Data.Where(e => e[HierarchicalPropertyKey] == null);
	        grid.Reload();
	        grid.CollapseAll();
	        grid.ExpandRows(Data);
        }
    }
    
    void OnClick(RadzenSplitButtonItem item, IDictionary<string,object> entityProperties)
    {
	    if (item != null)
	    {
		    switch (item.Value)
		    {
			    case "inside":
				    _ = InsertInsideRow(entityProperties);
				    break;
				case "after":
				    _ = InsertAfterRow(entityProperties);
				    break;
		    }
		    // Console.WriteLine($"item with value {item.Value} clicked");
		    // NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "SplitButton Item Clicked", Detail = $"{buttonName}, item with value {item.Value} clicked" });
	    }
	    else
	    {
		    // Console.WriteLine($"clicked");
		    // NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "SplitButton Clicked", Detail = $"{buttonName} clicked" });
	    }
    }

    private void OnChangeProperty(IDictionary<string,object> entityProperties, string property, object s)
    {
	    entityProperties[property] = s;
	    // propertiesToEdit[property] = s;
    }

}