@using Microsoft.JSInterop
@using WebVella.Erp.Api.Models;

@inject IJSRuntime JSRuntime;
@using Radzen
@using Radzen.Blazor
@using WebVella.TagHelpers.Models
@using Microsoft.AspNetCore.Components.Sections
@if(FieldOptions.Mode == WvFieldRenderMode.InlineEdit){
    @inject NotificationService NotificationService
}

@if (_isVisible)
{

    @switch (FieldOptions.Mode)
    {
        case WvFieldRenderMode.InlineEdit:
            <SectionOutlet SectionName=@("field-inline-"+Node.Id)/>
            break;
        case WvFieldRenderMode.Display:
            <SectionOutlet SectionName=@("field-display-"+Node.Id)/>
            break;
        default:
            <SectionOutlet SectionName=@("field-form-"+Node.Id)/>
            break;
    }
}

<SectionContent SectionName=@("field-inline-"+Node.Id)>
    <RadzenTemplateForm TItem="string" Data=@_fieldValue Submit="OnSubmit" @ref="_form">
        @if (_inlineEditable)
        {
            <SectionOutlet SectionName=@("field-form-"+Node.Id)/>
            <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1 rz-mt-3" Click="@((args) => SaveRow())" aria-label="Save"/>
            <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1 rz-mt-3" Click="@((args) => CancelEdit())" aria-label="Cancel"/>
        }
        else
        {
            <SectionOutlet SectionName=@("field-display-"+Node.Id)/>
            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1 rz-mt-3" Click="@(args => EditRow())"/>
        }
    </RadzenTemplateForm>
</SectionContent>

<SectionContent SectionName=@("field-form-" + Node.Id)>
    <RadzenFormField Text=@FieldOptions.LabelText Variant="Variant.Outlined" Component=@FieldOptions.Name>
        <RadzenTextBox @bind-Value="@_fieldValue" MaxLength=@(FieldOptions.MaxLength==0?null:FieldOptions.MaxLength) Placeholder=@(FieldOptions.Placeholder) Name=@FieldOptions.Name/>
        @if (_isRequired)
        {
            <RadzenRequiredValidator Component=@FieldOptions.Name Text="This field is required." Popup=true Style="position: absolute"/>
        }
    </RadzenFormField>
    @* <RadzenDropDown AllowClear="true" @bind-Value=@FieldOptions.Value *@
    @*                 LoadData=@LoadData AllowFiltering="true" Placeholder="@FieldOptions.Placeholder" *@
    @*                 Data=@options TextProperty="@nameof(SelectOption.Label)" ValueProperty="@nameof(SelectOption.Value)" Style="width: 100%; max-width: 400px;" Name="@FieldOptions.Name"/> *@
</SectionContent>

<SectionContent SectionName=@("field-display-" + Node.Id)>
    <RadzenFormField Text=@FieldOptions.LabelText Variant="Variant.Outlined">
        <RadzenTextBox @bind-Value="@_fieldValue" Disabled="true"/>
    </RadzenFormField>
</SectionContent>