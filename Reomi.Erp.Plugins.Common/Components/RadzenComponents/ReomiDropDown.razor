@using Microsoft.JSInterop
@using WebVella.Erp.Api.Models;

@inject IJSRuntime JSRuntime;
@using Radzen
@using Radzen.Blazor
@using WebVella.TagHelpers.Models
@using Microsoft.AspNetCore.Components.Sections
@inherits ReomiFieldComponentBase<WebVella.Erp.Web.Components.PcFieldSelect.PcFieldSelectOptions>

@if(FieldOptions.Mode == WvFieldRenderMode.InlineEdit){
    @inject NotificationService NotificationService
}

@if (IsVisible)
{
    @switch (FieldOptions.Mode)
    {
        case WvFieldRenderMode.InlineEdit:
            <SectionOutlet SectionName=@("field-inline-"+Context.Node.Id)/>
            break;
        case WvFieldRenderMode.Display:
            <SectionOutlet SectionName=@("field-display-"+Context.Node.Id)/>
            break;
        default:
            <SectionOutlet SectionName=@("field-form-"+Context.Node.Id)/>
            break;
    }
}
@* @if (FieldOptions.LabelMode != WvLabelRenderMode.Hidden) *@
@* { *@
@*     $1$ <RadzenStack Orientation="@Orientation" Gap="0.5rem" class="@FieldOptions.Class"> #1# *@
@*     $1$     <RadzenLabel Text="@FieldOptions.LabelText" Component="@FieldOptions.Name"/> #1# *@
@*         <SectionOutlet SectionName="field-inline" /> *@
@*     // </RadzenStack> *@
@* } *@
@* else *@
@* { *@
@*     <SectionOutlet SectionName="field" /> *@
@* } *@

<SectionContent SectionName=@("field-inline-"+Context.Node.Id)>
    <RadzenTemplateForm TItem="BlazorForm" Data=@Context.FormData Submit="OnSubmit" @ref="Form">
        @if (IsInlineEditable)
        {
            <SectionOutlet SectionName=@("field-form-"+Context.Node.Id)/>
            <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1 rz-mt-3" Click="@((args) => SaveRow())" aria-label="Save"/>
            <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1 rz-mt-3" Click="@((args) => CancelEdit())" aria-label="Cancel"/>
        }
        else
        {
            <SectionOutlet SectionName=@("field-display-"+Context.Node.Id)/>
            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1 rz-mt-3" Click="@(args => EditRow())"/>
        }
    </RadzenTemplateForm>
</SectionContent>

<SectionContent SectionName=@("field-form-" + Context.Node.Id)>
    <input type="hidden" name=@FieldName value="@Context.FormData![FieldName]" />
    <RadzenFormField Text="@FieldOptions.LabelText" Variant="Variant.Outlined" Component=@(FieldName + "-helper") Style="width:calc(100% - 88px);">
        <RadzenDropDown Data=@options TValue="string" AllowClear=@(!IsRequired) AllowFiltering="true" @bind-Value=@Context.FormData![FieldName] LoadData=@LoadData TextProperty="@nameof(SelectOption.Label)" ValueProperty="@nameof(SelectOption.Value)" Name="@(FieldName + "helper")" />
        @if (IsRequired)
        {
            <RadzenRequiredValidator Component=@(FieldName + "-helper") Text="Last name is required." Popup=true Style="position: absolute"/>
        }
    </RadzenFormField>
    @* <RadzenDropDown AllowClear="true" @bind-Value=@FieldOptions.Value *@
    @*                 LoadData=@LoadData AllowFiltering="true" Placeholder="@FieldOptions.Placeholder" *@
    @*                 Data=@options TextProperty="@nameof(SelectOption.Label)" ValueProperty="@nameof(SelectOption.Value)" Style="width: 100%; max-width: 400px;" Name="@FieldOptions.Name"/> *@
</SectionContent>

<SectionContent SectionName=@("field-display-"+Context.Node.Id)>
    <RadzenFormField Text="@FieldOptions.LabelText" Variant="Variant.Outlined" Component=@FieldName Style="width: calc(100% - 44px);">
        <RadzenDropDown Disabled="true" Data=@options TValue="string" AllowClear="false" AllowSorting="false" @bind-Value=@Context.FormData![FieldName] LoadData=@LoadData TextProperty="@nameof(SelectOption.Label)" ValueProperty="@nameof(SelectOption.Value)" />
    </RadzenFormField>
</SectionContent>